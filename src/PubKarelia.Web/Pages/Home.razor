@page "/"

<input @bind="coordinates" placeholder="x,y" />
<button @onclick="Move">Move</button>

<div style="position:relative; width:1000px; height:1000px;">
    <img src="KareliaPub.png" width="1000" height="1000" style="position:absolute;" />
    <svg width="1000" height="1000" style="position:absolute; pointer-events:none;">
        <line x1="0" y1="0" x2="@x" y2="@y" stroke="red" stroke-width="3" />
    </svg>
</div>

@code {
    private string coordinates = "";

    // we need to figure this out
    private int x;
    private int y;

    private void Move()
    {
        var parts = coordinates.Split(',');
        x = int.Parse(parts[0]);
        y = int.Parse(parts[1]);
    }
}